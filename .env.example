# Microsoft SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_NAME=ClinicManagementDB
DB_USER=clinic_app
DB_PASSWORD=change_me
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Authentication
JWT_SECRET=replace_with_a_long_random_secret_before_running_the_application
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# FastAPI and desktop client
APP_DEBUG=false
API_SCHEME=http
API_HOST=127.0.0.1
API_PORT=8000
API_TIMEOUT_SECONDS=15
