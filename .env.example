# Microsoft SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_NAME=ClinicManagementDB
DB_USER=sa
DB_PASSWORD=123456
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Authentication
JWT_SECRET=replace_with_a_long_random_secret_before_running_the_application
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APPOINTMENT_GRACE_MINUTES=15

# Desktop Client
APP_MODE=demo
API_SCHEME=http
API_HOST=127.0.0.1
API_PORT=8000
API_TIMEOUT_SECONDS=15
CLINIC_TIMEZONE=Asia/Ho_Chi_Minh
CLINIC_DEMO_NOW=2026-10-07T09:59:00+07:00